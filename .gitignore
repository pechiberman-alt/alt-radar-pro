# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

/dist/
/build/
/.wrangler/
/outputs/
/work/
.sites-dev*.log
.gh-auth-*.log
.cf-auth-*.log
.codex-remote-attachments/

# typescript incremental build cache
tsconfig.tsbuildinfo
*.tsbuildinfo

# la araña dibujada: se genera con npm run arana -- --vista
/docs/araña/vista.html

# la página de la araña la genera el build (npm run arana -- --pagina)
/public/arana/

# estado local de Ruflo (el MCP de los agentes, ver CLAUDE.md)
/.swarm/
/.claude-flow/
/ruvector.db*
# política que Ruflo adopta sola al diagnosticar (ver CLAUDE.md)
/.claude/proven-config.json
/.claude/.proven-config-version

# lo que baja y calcula la investigación de la mesa (scripts/investigacion/README.md)
/datos-investigacion/
/salida-investigacion/
